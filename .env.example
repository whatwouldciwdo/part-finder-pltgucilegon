# Salin file ini menjadi ".env" (di folder yang sama), lalu isi nilainya.
# File .env tidak ikut Git (sudah ada di .gitignore).

# Pilih penyedia: gemini atau openai (openai = semua yang OpenAI-compatible)
PROVIDER=openai

# --- Jika PROVIDER=openai ---
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- Database & App ---
DATABASE_URL=postgresql://postgres:password@10.8.140.69:5432/part_finder
APP_PORT=3230

# --- Jika PROVIDER=gemini ---
GEMINI_API_KEY=
